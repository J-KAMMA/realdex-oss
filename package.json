{
  "name": "real-dex",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "npm run test:contracts && npm run test:call-arity && npm run test:release-plan && npm run test:cctp-artifact && npm run test:cctp-deployment-metadata && npm run test:hooks && npm run test:ui",
    "test:hooks": "node scripts/checkHookDependencies.mjs",
    "test:release-plan": "node --test --test-reporter=tap scripts/createEvmTestnetReleasePlan.test.mjs",
    "test:contracts": "hardhat test",
    "test:cctp-artifact": "node scripts/createCctpAssetVerificationArtifact.mjs --self-test",
    "test:cctp-deployment-metadata": "node scripts/createCctpDeploymentMetadataReport.mjs --self-test",
    "test:ui": "vitest run",
    "verify:cctp-asset": "node scripts/createCctpAssetVerificationArtifact.mjs",
    "verify:cctp-deployment-metadata": "node scripts/createCctpDeploymentMetadataReport.mjs",
    "sign:asset-manifest": "node scripts/signAssetManifest.mjs",
    "release:plan:base-sepolia": "node scripts/createEvmTestnetReleasePlan.mjs",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "seed:local": "hardhat run scripts/seedDemo.ts --network localhost",
    "seed:multi-venue": "hardhat run scripts/seedMultiVenue.ts --network localhost",
    "test:call-arity": "node scripts/checkContractCallArity.mjs",
    "verify:clean-room": "node scripts/verifyCleanRoomReproduction.mjs",
    "postbuild": "node scripts/stampReleaseId.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-solana-kit": "1.6.1",
    "@circle-fin/adapter-viem-v2": "1.17.0",
    "@circle-fin/bridge-kit": "1.14.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@noble/curves": "1.9.1",
    "@scure/base": "2.2.0",
    "@solana/kit": "5.5.1",
    "@vitejs/plugin-react": "5.2.0",
    "ethers": "6.17.0",
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.38.6",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "chai": "4.5.0",
    "hardhat": "2.29.1",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
